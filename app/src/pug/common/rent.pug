section.rent#rent 
  .rent__wrapper 
    h2.page__title Аренда площадки
    .rent__slider.swiper 
      .swiper-wrapper 
        a(href="./assets/images/a8f1802a9c70deb2013d81f4818e04ac.png" data-fancybox="rent-gallery").rent__slide 
          picture 
            source(srcset=`./assets/images/a8f1802a9c70deb2013d81f4818e04ac.webp`, type="image/webp")
            source(srcset=`./assets/images/a8f1802a9c70deb2013d81f4818e04ac.png`, type="image/png")
            img(src=`./assets/images/a8f1802a9c70deb2013d81f4818e04ac.png` alt=``).image
        a(href="./assets/images/699cff431b0240e3cf12ce21c6884dc0.png" data-fancybox="rent-gallery").rent__slide  
          picture 
            source(srcset=`./assets/images/699cff431b0240e3cf12ce21c6884dc0.webp`, type="image/webp")
            source(srcset=`./assets/images/699cff431b0240e3cf12ce21c6884dc0.png`, type="image/png")
            img(src=`./assets/images/699cff431b0240e3cf12ce21c6884dc0.png` alt=`` loading="lazy").image
      .rent__pagination 
        .rent__indx 
          span.current 1
          span /
          span.total 1
        .slider__arrows 
          .slider__arrow.rent__prev
            svg(width="10" height="16" viewBox="0 0 10 16").icon 
              use(href=`assets/images/sprite.svg#arrow-prev`)
          .slider__arrow.rent__next
            svg(width="10" height="16" viewBox="0 0 10 16").icon 
              use(href=`assets/images/sprite.svg#arrow-next`)
    .rent__info 
      .rent__location 
        .rent__location-icon 
          svg(width="24" height="24" viewBox="0 0 24 24").icon 
            use(href=`assets/images/sprite.svg#location`)
        .rent__location-info 
          p Жилино, ул. Пригородная, 42
          a(href="./contacts.html") Смотреть на карте
      .rent__list 
        mixin item(icon, text)
          .rent__item
            svg(width="25" height="25" viewBox="0 0 25 25").icon 
              use(href=`assets/images/sprite.svg#${icon}`)
            p= text 
        +item("size", "Размер: 40*20 м")
        +item("heat", "Обогреваемое поле для круглогодичного использования")
        +item("shower","4 раздевалки, 20 душевых")
        +item("cart","Электронные ключи")
      .rent__btns 
        .price.btn от 2500 руб/час
        a(href="#callme" data-fancybox).btn забронировать 